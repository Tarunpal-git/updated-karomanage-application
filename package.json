  "private": true,
  "scripts": {
    "android": "SET ENVFILE=.env.production && react-native run-android",
    "android-dev": "SET ENVFILE=.env.development && react-native run-android --mode=devDebug --appIdSuffix=dev",
    "android-dev:mac": "export SET ENVFILE=.env.development && react-native run-android --mode=devDebug --appIdSuffix=dev",
    "android-prod:mac": "export SET ENVFILE=.env.production && react-native run-android --mode=prodDebug",
    "android-local": "react-native run-android --mode=devDebug --appIdSuffix=dev",
    "release:mac": "cd android && ENVFILE=.env.production ./gradlew assembleProdRelease",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "clean": "cd android && ./gradlew clean",
    "cleanApp": "cd android && ./gradlew uA",
    "reset-cache": "react-native start --reset-cache"
  },
